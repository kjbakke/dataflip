{
  "name": "dataflip",
  "displayName": "DataFlip",
  "description": "Browse, query, filter and edit PostgreSQL, MySQL, SQL Server, SQLite and BigQuery right inside VS Code.",
  "version": "0.1.0",
  "publisher": "dataflip",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1B4B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kjbakke/dataflip.git"
  },
  "bugs": {
    "url": "https://github.com/kjbakke/dataflip/issues"
  },
  "homepage": "https://github.com/kjbakke/dataflip#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "sql",
    "database",
    "postgresql",
    "mysql",
    "sql server",
    "sqlite",
    "bigquery",
    "query",
    "data grid"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataflip",
          "title": "Database",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dataflip": [
        {
          "id": "dataflip.sources",
          "name": "Data Sources",
          "icon": "$(database)"
        },
        {
          "id": "dataflip.history",
          "name": "Query History",
          "icon": "$(history)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dataflip.sources",
        "contents": "No data sources yet.\n[Add Data Source](command:dataflip.addSource)"
      }
    ],
    "commands": [
      {
        "command": "dataflip.addSource",
        "title": "Add Data Source",
        "category": "Database",
        "icon": "$(add)"
      },
      {
        "command": "dataflip.removeSource",
        "title": "Remove Data Source",
        "category": "Database",
        "icon": "$(trash)"
      },
      {
        "command": "dataflip.refresh",
        "title": "Refresh",
        "category": "Database",
        "icon": "$(refresh)"
      },
      {
        "command": "dataflip.disconnect",
        "title": "Disconnect",
        "category": "Database",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dataflip.newConsole",
        "title": "New Query Console",
        "category": "Database",
        "icon": "$(terminal)"
      },
      {
        "command": "dataflip.openTable",
        "title": "Open Table Data",
        "category": "Database",
        "icon": "$(table)"
      },
      {
        "command": "dataflip.copyName",
        "title": "Copy Name",
        "category": "Database"
      },
      {
        "command": "dataflip.attachSource",
        "title": "Attach Data Source to File",
        "category": "Database"
      },
      {
        "command": "dataflip.execute",
        "title": "Execute Statement",
        "category": "Database",
        "icon": "$(play)"
      },
      {
        "command": "dataflip.addColumn",
        "title": "Add Column…",
        "category": "Database",
        "icon": "$(add)"
      },
      {
        "command": "dataflip.renameColumn",
        "title": "Rename Column…",
        "category": "Database"
      },
      {
        "command": "dataflip.dropColumn",
        "title": "Drop Column…",
        "category": "Database"
      },
      {
        "command": "dataflip.deleteConsole",
        "title": "Delete Console",
        "category": "Database",
        "icon": "$(trash)"
      },
      {
        "command": "dataflip.history.open",
        "title": "Open in Console",
        "category": "Database"
      },
      {
        "command": "dataflip.history.rerun",
        "title": "Run Again",
        "category": "Database",
        "icon": "$(play)"
      },
      {
        "command": "dataflip.history.copy",
        "title": "Copy SQL",
        "category": "Database",
        "icon": "$(copy)"
      },
      {
        "command": "dataflip.history.clear",
        "title": "Clear Query History",
        "category": "Database",
        "icon": "$(clear-all)"
      },
      {
        "command": "dataflip.editSource",
        "title": "Edit Data Source…",
        "category": "Database",
        "icon": "$(edit)"
      },
      {
        "command": "dataflip.duplicateSource",
        "title": "Duplicate Data Source",
        "category": "Database",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dataflip.addSource",
          "when": "view == dataflip.sources",
          "group": "navigation@1"
        },
        {
          "command": "dataflip.refresh",
          "when": "view == dataflip.sources",
          "group": "navigation@2"
        },
        {
          "command": "dataflip.history.clear",
          "when": "view == dataflip.history",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dataflip.newConsole",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "inline@1"
        },
        {
          "command": "dataflip.newConsole",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "1_main@1"
        },
        {
          "command": "dataflip.refresh",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "1_main@2"
        },
        {
          "command": "dataflip.disconnect",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "1_main@3"
        },
        {
          "command": "dataflip.removeSource",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "9_danger@1"
        },
        {
          "command": "dataflip.openTable",
          "when": "view == dataflip.sources && viewItem == table",
          "group": "inline@1"
        },
        {
          "command": "dataflip.openTable",
          "when": "view == dataflip.sources && viewItem == table",
          "group": "1_main@1"
        },
        {
          "command": "dataflip.copyName",
          "when": "view == dataflip.sources && viewItem =~ /^(table|column|schema)$/",
          "group": "1_main@2"
        },
        {
          "command": "dataflip.addColumn",
          "when": "view == dataflip.sources && viewItem == table",
          "group": "2_columns@1"
        },
        {
          "command": "dataflip.renameColumn",
          "when": "view == dataflip.sources && viewItem == column",
          "group": "2_columns@1"
        },
        {
          "command": "dataflip.dropColumn",
          "when": "view == dataflip.sources && viewItem == column",
          "group": "9_danger@1"
        },
        {
          "command": "dataflip.deleteConsole",
          "when": "view == dataflip.sources && viewItem == console",
          "group": "9_danger@1"
        },
        {
          "command": "dataflip.history.rerun",
          "when": "view == dataflip.history && viewItem == history",
          "group": "inline@1"
        },
        {
          "command": "dataflip.history.copy",
          "when": "view == dataflip.history && viewItem == history",
          "group": "inline@2"
        },
        {
          "command": "dataflip.history.open",
          "when": "view == dataflip.history && viewItem == history",
          "group": "1_main@1"
        },
        {
          "command": "dataflip.history.rerun",
          "when": "view == dataflip.history && viewItem == history",
          "group": "1_main@2"
        },
        {
          "command": "dataflip.history.copy",
          "when": "view == dataflip.history && viewItem == history",
          "group": "1_main@3"
        },
        {
          "command": "dataflip.newConsole",
          "when": "view == dataflip.sources && viewItem == database",
          "group": "inline@1"
        },
        {
          "command": "dataflip.newConsole",
          "when": "view == dataflip.sources && viewItem == database",
          "group": "1_main@1"
        },
        {
          "command": "dataflip.refresh",
          "when": "view == dataflip.sources && viewItem =~ /^(database|schema|table)$/",
          "group": "1_main@9"
        },
        {
          "command": "dataflip.copyName",
          "when": "view == dataflip.sources && viewItem == database",
          "group": "1_main@2"
        },
        {
          "command": "dataflip.editSource",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "inline@2"
        },
        {
          "command": "dataflip.editSource",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "3_source@1"
        },
        {
          "command": "dataflip.duplicateSource",
          "when": "view == dataflip.sources && viewItem == source",
          "group": "3_source@2"
        }
      ],
      "editor/title": [
        {
          "command": "dataflip.execute",
          "when": "editorLangId == sql",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dataflip.openTable",
          "when": "false"
        },
        {
          "command": "dataflip.copyName",
          "when": "false"
        },
        {
          "command": "dataflip.removeSource",
          "when": "false"
        },
        {
          "command": "dataflip.disconnect",
          "when": "false"
        },
        {
          "command": "dataflip.addColumn",
          "when": "false"
        },
        {
          "command": "dataflip.renameColumn",
          "when": "false"
        },
        {
          "command": "dataflip.dropColumn",
          "when": "false"
        },
        {
          "command": "dataflip.deleteConsole",
          "when": "false"
        },
        {
          "command": "dataflip.history.open",
          "when": "false"
        },
        {
          "command": "dataflip.history.rerun",
          "when": "false"
        },
        {
          "command": "dataflip.history.copy",
          "when": "false"
        },
        {
          "command": "dataflip.editSource",
          "when": "false"
        },
        {
          "command": "dataflip.duplicateSource",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dataflip.execute",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ]
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "mssql": "^11.0.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  }
}
